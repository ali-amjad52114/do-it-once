# Do It Once — environment variables. Copy to .env and fill in. All are server-only
# unless prefixed NEXT_PUBLIC_. Never expose provider keys to the browser.

# ── Neon (persistent brain) ─────────────────────────────
# Pooled connection string (host contains -pooler) for app queries.
DATABASE_URL=
# Neon API key (console > Account > API keys); used for branching/admin scripts.
NEON_API_KEY=
# Neon AI Gateway (LLMs + embeddings). Needs a paid plan AND AI Gateway credits.
# Create with: neon credentials create --scope ai_gateway:invoke  (or Console > Connect > AI Gateway)
NEON_AI_GATEWAY_BASE_URL=https://br-<branch>-api.ai.<cell>.<region>.aws.neon.tech
NEON_AI_GATEWAY_TOKEN=

# ── Mastra (orchestration) ──────────────────────────────
# Mastra model gateway key, used by model strings like "mastra/openai/gpt-5-mini".
MASTRA_GATEWAY_API_KEY=

# ── Kernel (cloud browsers) ─────────────────────────────
# kernel.sh dashboard > API keys. Read automatically by @onkernel/sdk.
KERNEL_API_KEY=

# ── Demo membership site ────────────────────────────────
# Public base URL of demo-site/ (Kernel's cloud browsers cannot reach localhost).
DEMO_SITE_URL=https://do-it-once-demo.fly.dev
# Shared secret for the demo site's POST /api/reset endpoint.
DEMO_RESET_TOKEN=

# ── Exa (repair / research) ─────────────────────────────
EXA_API_KEY=

# ── AgentMail (agent inbox) ─────────────────────────────
AGENTMAIL_API_KEY=
# Created by: npx tsx scripts/agentmail-setup.ts (prints these)
AGENTMAIL_INBOX_ID=do-it-once-agent@agentmail.to
AGENTMAIL_SENDER_INBOX_ID=lumen-billing-demo@agentmail.to
AGENTMAIL_WEBHOOK_SECRET=
# Public URL of this app, only needed to register the AgentMail webhook (tunnel or Fly URL)
PUBLIC_APP_URL=

# ── Assistant UI Cloud (chat thread persistence, Phase 2) ─
ASSISTANT_API_KEY=

# ── Fly.io Sprites (agent workspace) ────────────────────
# sprites.dev/account → org token (org-slug/org-id/token-id/token-value)
SPRITES_TOKEN=
# Optional: SPRITE_NAME=do-it-once-agent  SPRITE_WORKSPACE=/home/sprite/workspace

# ── Executor (API/MCP actions) ──────────────────────────
# Cloud: https://executor.sh/mcp + a user API key (sk_...). Without these, a local `executor` CLI
# is used over stdio (EXECUTOR_LOCAL=0 disables; EXECUTOR_BIN overrides the path), else .ics fallback.
EXECUTOR_MCP_URL=https://executor.sh/mcp
EXECUTOR_API_KEY=

# ── Mastra observability (optional) ────────────────────
# Traces are always stored in Neon; set this to also export to Mastra platform.
MASTRA_PLATFORM_ACCESS_TOKEN=

# ── Add-ons (all default off; see docs/ADDONS.md) ──────
ADDON_JUDGE=0
ADDON_MCP=0
ADDON_GUIDE=0
ADDON_DISCOVER=0
# Bearer token Claude must send to /api/mcp (A2)
MCP_TOKEN=

# Demo pacing: minimum ms per browser step so the checklist matches the live view (0 = off)
STEP_MIN_MS=2000
