# Do It Once — environment variables. Copy to .env and fill in. All are server-only
# unless prefixed NEXT_PUBLIC_. Never expose provider keys to the browser.

# ── Neon (persistent brain) ─────────────────────────────
# Pooled connection string (host contains -pooler) for app queries.
DATABASE_URL=
# Neon API key (console > Account > API keys); used for branching/admin scripts.
NEON_API_KEY=

# ── Mastra (orchestration) ──────────────────────────────
# Mastra model gateway key, used by model strings like "mastra/openai/gpt-5-mini".
MASTRA_GATEWAY_API_KEY=

# ── Kernel (cloud browsers) ─────────────────────────────
# kernel.sh dashboard > API keys. Read automatically by @onkernel/sdk.
KERNEL_API_KEY=

# ── Demo membership site ────────────────────────────────
# Public base URL of demo-site/ (Kernel's cloud browsers cannot reach localhost).
DEMO_SITE_URL=https://do-it-once-demo.fly.dev
# Shared secret for the demo site's POST /api/reset endpoint.
DEMO_RESET_TOKEN=

# ── Exa (repair / research) ─────────────────────────────
EXA_API_KEY=

# ── AgentMail (agent inbox, Phase 4) ────────────────────
AGENTMAIL_API_KEY=

# ── Assistant UI Cloud (chat thread persistence, Phase 2) ─
ASSISTANT_API_KEY=

# ── Fly.io Sprites (agent workspace, Phase 6) ───────────
SPRITES_TOKEN=

# ── Executor (API/MCP actions, Phase 6) ─────────────────
EXECUTOR_MCP_URL=
EXECUTOR_API_KEY=
